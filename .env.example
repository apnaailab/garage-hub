# Local frontend
VITE_API_URL=http://localhost:5080/api

# Production API: copy the Session pooler connection from Supabase > Connect.
ConnectionStrings__GarageHub=Host=aws-0-region.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=CHANGE_ME;SSL Mode=Require
Jwt__Key=replace-with-at-least-32-random-characters
AllowedOrigins__0=https://garage.example.com
Database__ApplyMigrations=true
Seed__DemoData=false

# Used once only when the production database has no users.
Bootstrap__OrganizationName=Example Garage
Bootstrap__OwnerEmail=owner@example.com
Bootstrap__OwnerPassword=replace-with-a-strong-password

# Private document storage. Never expose the service-role key to Vite/browser code.
Storage__Provider=Supabase
Supabase__Url=https://PROJECT_REF.supabase.co
Supabase__ServiceRoleKey=CHANGE_ME
Supabase__StorageBucket=garage-documents
